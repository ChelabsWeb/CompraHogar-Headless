# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# Checkout. "true" = checkout enabled (buttons lead to payment gateway).
# Any other value or unset = checkout in construction (blocked, fail-closed).
# Keep disabled until the payment gateway (Shopify or Medusa) is ready to sell.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Analytics
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=123456789012345

# Site
NEXT_PUBLIC_SITE_URL=https://comprahogar.uy
