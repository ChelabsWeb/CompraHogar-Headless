# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# one-off debug/exploration scripts (NEVER commit — may contain hardcoded credentials)
.check_*.js
.check_*.ts
.check_*.mjs
.debug_*.js
.debug_*.ts
.debug_*.mjs

# sales/proposal artifacts — live outside the repo or in docs/ventas/
/*.xlsx
/*.pdf
/CompraHogar-Propuesta-*
/index.html
.~lock.*#

# Claude Code local configuration (per-machine paths, permissions, agents)
.claude/settings.local.json
.claude/agents/
.claude/scheduled_tasks.lock

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.tmp-screenshots/
